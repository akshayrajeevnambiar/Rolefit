# Local secrets. .env* is ignored. The committed template is .env.example.
.env
.env.*
!.env.example

# Private keys and certificates.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub

# Database dumps. backend/docker/init-pgvector.sql is a schema script, not a dump.
*.dump
*.bak
*.sql.gz
*.sql.bz2
*dump*.sql
*.sqlite
*.sqlite3
*.db

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Node
node_modules/
dist/
.vite/

# Editor and OS
.DS_Store
.idea/
.vscode/
