# Copy this file to .env for local development:
#   cp .env.example .env
#
# .env is gitignored. These values are local placeholders, not production
# secrets. Docker Compose reads .env for ${VAR} substitution and falls
# back to the same placeholders when .env is absent.
# Inside Compose, the API is pointed at the database service (host "db")
# by docker-compose.yml. Use localhost here for commands you run on the host.

DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=rolefit
POSTGRES_USER=rolefit
POSTGRES_PASSWORD=rolefit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
