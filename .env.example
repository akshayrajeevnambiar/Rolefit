# Copy this file to .env for local development:
#   cp .env.example .env
#
# .env is gitignored. These values are local placeholders, not production
# secrets. Docker Compose reads .env for ${VAR} substitution.
# Debug stays off unless DJANGO_DEBUG is set here. The placeholder
# secret below is accepted only while debug is on.
# Inside Compose, the API is pointed at the database service (host "db")
# by docker-compose.yml. Use localhost here for commands you run on the host.

DJANGO_SECRET_KEY=dev-only-not-a-secret
# Local opt-in. Compose leaves debug off when this variable is unset.
# To run with debug off, remove this line and replace the secret above
# with a unique value of at least 50 characters.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=rolefit
POSTGRES_USER=rolefit
POSTGRES_PASSWORD=rolefit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
